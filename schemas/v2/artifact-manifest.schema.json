{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bubble-matrix-map:schema:artifact-manifest:2",
  "title": "Artifact manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "cliVersion", "renderContractVersion", "files"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "artifactId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "cliVersion": { "type": "string", "minLength": 1 },
    "renderContractVersion": { "enum": [1, 2] },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "$comment": "Runtime validation also requires file.path values to be unique. Standard JSON Schema cannot compare sibling string values, so consumers must apply that semantic check after Schema validation.",
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "svg" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "result" } }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "bytes"],
        "properties": {
          "role": { "enum": ["svg", "result"] },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])(?:\\.|\\.\\.)(?:[\\\\/]|$))(?!.*[\\\\/]$)(?!.*[\\\\/]{2})[^\\r\\n]+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
